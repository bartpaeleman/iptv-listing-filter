# IPTV & EPG Manager - Apache Security Rules
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Block direct HTTP access to internal directories
RedirectMatch 403 ^/(app|database|storage|bin|views)/.*$
